{
  "name": "hiatlas-institutional",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "node scripts/optimize-brand.mjs && tsc --noEmit && vite build && tsx scripts/prerender.tsx && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json index.html"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
